{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "english-fun",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get dist/404.html with a real 404 status (good for search engines).
    "not_found_handling": "404-page",
    // The Worker fills in the site address on pages, robots.txt and sitemap.xml; built JS/CSS/images skip it.
    "run_worker_first": ["/*", "!/assets/*", "!/img/*", "!/site.css"]
  },
  // The site's main address, used in canonical links, Open Graph and the sitemap (see worker/site.ts).
  "vars": {
    "SITE_URL": "https://englishfun.app"
  },
  // Keep variables set in the Cloudflare dashboard (SIGNUP_ENABLED, TURNSTILE_SITE_KEY, AI limits...) on deploy.
  "keep_vars": true,
  // Needed by Cloudflare's preview builds of pull requests (`wrangler preview`); top-level settings apply.
  "previews": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-fun"
    }
  ]
}
